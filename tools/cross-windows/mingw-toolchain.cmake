# MinGW-w64 cross build of troublemakers.exe from Linux (see README.md here).
# TM_XDEPS: the folder setup.sh filled (default /home/claude/xdeps).
if(DEFINED ENV{TM_XDEPS})
    set(TM_XDEPS "$ENV{TM_XDEPS}")
else()
    set(TM_XDEPS /home/claude/xdeps)
endif()
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc-posix)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++-posix)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(CMAKE_FIND_ROOT_PATH /usr/x86_64-w64-mingw32 ${TM_XDEPS}/SDL2-2.30.3/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-idirafter ${TM_XDEPS}/winshim -include ${TM_XDEPS}/mingw_compat.h")
set(CMAKE_CXX_FLAGS_INIT "-idirafter ${TM_XDEPS}/winshim -include ${TM_XDEPS}/mingw_compat.h")
