# Writes the build stamp header at BUILD time (not configure time: a rebuild
# after a commit kept the old commit in the binary, and two players with the
# "same" build refused each other; worse, two different code states could
# carry one stamp and desync online).
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<path>/mm_build_stamp.h -P BuildStamp.cmake
#
# MM_GIT_COMMIT: the short commit, "+" appended when the tree has uncommitted
# changes (two dev builds are not the same build). MM_PREVIEW: the number in
# the repo's PREVIEW file (the package handed to the owner), "" without one.
# The file is rewritten only when its content changes, so nothing recompiles
# for nothing.
find_package(Git QUIET)
set(commit "unknown")
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse --short=12 HEAD
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE commit
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc
        ERROR_QUIET)
    if(NOT rc EQUAL 0 OR commit STREQUAL "")
        set(commit "unknown")
    else()
        execute_process(
            COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE dirty
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET)
        if(NOT dirty STREQUAL "")
            set(commit "${commit}+")
        endif()
    endif()
endif()

set(preview "")
if(EXISTS "${SOURCE_DIR}/PREVIEW")
    file(READ "${SOURCE_DIR}/PREVIEW" preview)
    string(STRIP "${preview}" preview)
endif()

set(content "// Generated by cmake/BuildStamp.cmake at build time; do not edit.
#pragma once
#define MM_GIT_COMMIT \"${commit}\"
#define MM_PREVIEW \"${preview}\"
")
set(current "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" current)
endif()
if(NOT current STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
