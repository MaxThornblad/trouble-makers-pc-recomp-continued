From 6f48529643b65361f9ae89ccb5a1e40fb1ffc913 Mon Sep 17 00:00:00 2001
From: Max Thornblad <max.thornblad@hotmail.com>
Date: Mon, 26 Oct 2026 14:30:05 +0100
Subject: [PATCH 12/14] Deterministic mode: run audio tasks on the game thread

Removes any ordering question between the game thread and the SP task thread
while replays or netplay need exact reproducibility.
---
 ultramodern/src/events.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ultramodern/src/events.cpp b/ultramodern/src/events.cpp
index 3d0c852..eac6cf9 100644
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -642,7 +642,16 @@ void ultramodern::submit_rsp_task(RDRAM_ARG PTR(OSTask) task_) {
     if (task->t.type == M_GFXTASK) {
         events_context.action_queue.enqueue(SpTaskAction{ *task });
     }
-    // Set all other tasks as the RSP task
+    // Set all other tasks as the RSP task. In deterministic mode run it right
+    // here on the game thread instead.
+    else if (deterministic_mode.load(std::memory_order_acquire)) {
+        if (!ultramodern::rsp::run_task(PASS_RDRAM task)) {
+            fprintf(stderr, "Failed to execute task type: %" PRIu32 "\n", task->t.type);
+            ULTRAMODERN_QUICK_EXIT();
+        }
+        sp_complete();
+        tasks_in_flight.fetch_sub(1, std::memory_order_release);
+    }
     else {
         events_context.sp_task_queue.enqueue(task);
     }
