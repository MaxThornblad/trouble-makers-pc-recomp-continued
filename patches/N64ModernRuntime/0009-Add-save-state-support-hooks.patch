+// Save-state support: RSP/RDP work submitted by the game but not yet signalled
+// back as an external message. Decremented only after the completion message
+// is enqueued, so "zero" means every completion is already visible to
+// dequeue_external_messages().
+static std::atomic<int> tasks_in_flight{0};
+
+bool ultramodern::wait_for_rsp_idle(std::chrono::milliseconds timeout) {
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    while (tasks_in_flight.load(std::memory_order_acquire) != 0) {
+        if (std::chrono::steady_clock::now() >= deadline) {
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+    return true;
+}
+
 void sp_complete() {
     uint8_t* rdram = events_context.rdram;
     std::lock_guard lock{ events_context.message_mutex };
@@ -284,6 +301,7 @@ void task_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_r
 
         // Tell the game that the RSP has completed
         sp_complete();
+        tasks_in_flight.fetch_sub(1, std::memory_order_release);
     }
 }
 
@@ -373,6 +391,7 @@ void gfx_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_re
                 [[maybe_unused]] auto renderer_end = std::chrono::high_resolution_clock::now();
 
                 dp_complete();
+                tasks_in_flight.fetch_sub(1, std::memory_order_release);
                 // TODO hook the parsed event up to the actual parsing point when a callback is added to RT64.
                 ultramodern::extensions::on_displaylist_parsed(displaylist);
                 ultramodern::extensions::on_displaylist_completed(displaylist);
@@ -555,6 +574,7 @@ extern "C" PTR(void) osViGetCurrentFramebuffer() {
