+// Save-state support: the ordered list of code sections the game has DMA'd
+// into RAM (by ROM address, so it survives a rebuild of the section table),
+// with duplicate loads of the same section at the same address collapsed to
+// the most recent one.
+std::vector<recomp::overlays::LoadedSectionRecord> recomp::overlays::get_loaded_sections() {
+    std::vector<LoadedSectionRecord> out;
+    for (size_t i = 0; i < loaded_sections.size(); i++) {
+        const LoadedSection& cur = loaded_sections[i];
+        bool superseded = false;
+        for (size_t j = i + 1; j < loaded_sections.size(); j++) {
+            if (loaded_sections[j].loaded_ram_addr == cur.loaded_ram_addr &&
+                loaded_sections[j].section_table_index == cur.section_table_index) {
+                superseded = true;
+                break;
+            }
+        }
+        if (!superseded) {
+            out.push_back({sections_info.code_sections[cur.section_table_index].rom_addr, cur.loaded_ram_addr});
+        }
+    }
+    return out;
+}
+
+bool recomp::overlays::restore_loaded_sections(const std::vector<LoadedSectionRecord>& records) {
+    for (const LoadedSectionRecord& r : records) {
+        if (code_sections_by_rom.find(r.rom_addr) == code_sections_by_rom.end()) {
+            return false;
+        }
+    }
+    loaded_sections.clear();
+    for (const LoadedSectionRecord& r : records) {
+        load_overlay(code_sections_by_rom[r.rom_addr], r.ram_addr);
+    }
+    return true;
+}
+
