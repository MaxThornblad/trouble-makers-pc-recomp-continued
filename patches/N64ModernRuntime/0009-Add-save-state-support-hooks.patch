     }
 }
 
+// Save-state support. Both run on the game thread, which owns deferred_messages.
+void ultramodern::deliver_pending_external_messages(RDRAM_ARG1) {
+    dequeue_external_messages(PASS_RDRAM1);
+}
+
+std::vector<ultramodern::PendingExternalMessage> ultramodern::get_deferred_external_messages() {
+    std::vector<PendingExternalMessage> out;
+    out.reserve(deferred_messages.size());
+    for (const QueuedMessage& m : deferred_messages) {
+        out.push_back({m.mq, m.mesg, m.jam, m.requeue_if_blocked});
+    }
+    return out;
+}
+
+void ultramodern::set_deferred_external_messages(const std::vector<PendingExternalMessage>& messages) {
+    deferred_messages.clear();
+    for (const PendingExternalMessage& m : messages) {
+        deferred_messages.push_back({m.mq, m.mesg, m.jam, m.requeue_if_blocked});
+    }
+}
+
 extern "C" void osCreateMesgQueue(RDRAM_ARG PTR(OSMesgQueue) mq_, PTR(OSMesg) msg, s32 count) {
     OSMesgQueue *mq = TO_PTR(OSMesgQueue, mq_);
     mq->blocked_on_recv = NULLPTR;
