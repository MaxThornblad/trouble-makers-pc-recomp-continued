 namespace RT64 {
     namespace GBI_RDP {
+        static int32_t signedRectX(uint32_t value) {
+            // MM's widened tile hooks encode off-left X coordinates in the
+            // 12-bit quarter-pixel field using two's complement. Keep those
+            // negative rectangles intact so RT64's normal scissor crops the
+            // geometry and texture interpolation together.
+            if ((value & 0x800U) != 0) {
+                return static_cast<int32_t>(value | ~0xFFFU);
+            }
+
+            return static_cast<int32_t>(value);
+        }
+
+        // A rectangle's right edge past 2047 with its left edge before it is
+        // one rectangle reaching off the right (a widened tile at the far
+        // right of the band), not a wrap to the left: read as negative, the
+        // right edge landed left of the left edge and the tile was drawn
+        // stretched backwards across the whole row (the mountain band in a
+        // split-screen half jumping or vanishing whenever its scroll put a
+        // tile across that line).
+        static int32_t rectRightX(int32_t ulx, uint32_t value) {
+            const int32_t lrx = signedRectX(value);
+            return (lrx < ulx) ? lrx + 0x1000 : lrx;
+        }
+
         void noOp(State *state, DisplayList **dl) {
             // Do nothing.
         }
