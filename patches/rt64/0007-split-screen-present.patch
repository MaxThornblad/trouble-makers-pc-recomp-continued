diff --git a/src/hle/rt64_split_screen.h b/src/hle/rt64_split_screen.h
new file mode 100644
index 0000000..76c132c
--- /dev/null
+++ b/src/hle/rt64_split_screen.h
@@ -0,0 +1,26 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace RT64 {
+    // Two-player split screen, set by the host. While secondAddress is not
+    // zero, each present draws the VI's framebuffer and the framebuffer at
+    // secondAddress into the top and bottom halves of the window (the VI's
+    // on top unless secondOnTop), and Expand derives the aspect ratio from a
+    // half-height window, capped at maxAspect when it is above zero.
+    struct SplitScreen {
+        std::atomic<uint32_t> secondAddress{ 0 };
+        std::atomic<bool> secondOnTop{ false };
+        std::atomic<float> maxAspect{ 0.0f };
+    };
+
+    inline SplitScreen &splitScreen() {
+        static SplitScreen state;
+        return state;
+    }
+};
